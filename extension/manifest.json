{
  "manifest_version": 3,
  "name": "Radium Download Manager",
  "version": "0.3.1",
  "description": "Automatic download capture and multi-layered video/stream detection (HLS/DASH/MP4/WebM/YouTube) for Radium Download Manager.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "webRequest",
    "webNavigation",
    "storage",
    "contextMenus",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Radium Media & Download Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "catch-script/catch.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "js/content-script.js"
      ],
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "catch-script/catch.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
