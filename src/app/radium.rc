// Radium Download Manager — Windows PE Version Resource & Application Metadata

#include <windows.h>

// Application Icon Resource
1 ICON "radium.ico"
IDI_APPLICATION ICON "radium.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Radium Open Source Contributors"
            VALUE "FileDescription",  "Radium Download Manager \u2014 Native Windows 11 Desktop Application"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "radium.exe"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sayed Alve and Radium Contributors. Licensed under Apache-2.0."
            VALUE "OriginalFilename", "radium.exe"
            VALUE "ProductName",      "Radium Download Manager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
